---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getImage } from '../utils/images';
import { siteData } from '../utils/data';

const { diy } = siteData;
---

<BaseLayout
  title="Do-It-Yourself Guides & Open Hardware · UPNALAB"
  description="Open source hardware tutorials, Instructables guides, code repositories and maker spaces by UPNALAB."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
        Do-It-Yourself
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
        We believe research should be open and accessible. Build your own acoustic levitators,
        ultrasonic phased arrays, and interactive displays using our open tutorials and schematics.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {diy.map(resource => (
        <article class="p-6 sm:p-8 rounded-3xl bg-white border border-slate-200 shadow-sm flex flex-col sm:flex-row gap-6 items-center hover:shadow-lg transition-all duration-200">
          <div class="w-32 h-32 shrink-0 rounded-2xl overflow-hidden bg-slate-100 ring-1 ring-slate-200">
            <Image
              src={getImage(resource.image)}
              alt=""
              width={128}
              height={128}
              densities={[1, 2]}
              loading="lazy"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="flex-1 text-center sm:text-left">
            <h2 class="text-xl font-bold text-slate-900 tracking-tight mb-2">
              {resource.title}
            </h2>
            <p class="text-sm text-slate-600 leading-relaxed mb-5">
              {resource.description}
            </p>
            <a
              href={resource.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-white shadow-sm transition-colors"
            >
              <span>Explore {resource.title}</span>
              <Icon name="external" class="w-3.5 h-3.5" />
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</BaseLayout>
