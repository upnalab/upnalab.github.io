---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import BibtexBlock from '../../components/BibtexBlock.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../utils/url';
import { getImage } from '../../utils/images';
import { getProjects, getPeople, findPersonForAuthor, doiUrl, cleanDoi, excerpt, type Project } from '../../utils/data';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const people = await getPeople();

const SITE = 'https://upnalab.com';
const isStudent = project.category === 'Student Project';

const paperLink = doiUrl(project);
const hasDoiOrPaper = Boolean(paperLink);
const doi = cleanDoi(project);

const academicCitation = {
  title: project.title,
  authors: project.authors,
  date: project.date,
  doi,
  pdfUrl: project.publicationUrl && project.publicationUrl.toLowerCase().endsWith('.pdf') ? project.publicationUrl : undefined,
  publicationUrl: paperLink,
};

const thumbnail = getImage(project.thumbnail);
const projectCanonicalUrl = `${SITE}/project/${project.slug}/`;

// Authors that are (or were) members of the lab link to their profile (D3)
const authors = project.authors.map(name => ({ name, person: findPersonForAuthor(name, people) }));

const scholarlyArticleJsonLd = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  "headline": project.title,
  "name": project.title,
  "description": project.abstract || project.title,
  ...(project.date ? { "datePublished": project.date } : {}),
  "image": `${SITE}${thumbnail.src}`,
  "url": projectCanonicalUrl,
  "mainEntityOfPage": projectCanonicalUrl,
  ...(project.authors.length > 0 ? {
    "author": project.authors.map(author => ({
      "@type": "Person",
      "name": author
    }))
  } : {}),
  "publisher": {
    "@id": `${SITE}/#organization`
  },
  ...(paperLink ? { "sameAs": paperLink } : {}),
  ...(project.tags.length > 0 ? { "keywords": project.tags.join(', ') } : {})
};

const parentCategoryName = isStudent ? 'Student Projects' : 'Research Projects';
const parentCategoryPath = isStudent ? '/student-projects' : '/';

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE },
    { "@type": "ListItem", "position": 2, "name": parentCategoryName, "item": `${SITE}${parentCategoryPath}` },
    { "@type": "ListItem", "position": 3, "name": project.title, "item": projectCanonicalUrl }
  ]
};
---

<BaseLayout
  title={`${project.title} · UPNALAB`}
  description={excerpt(project.abstract, 160) || project.title}
  image={thumbnail}
  article={true}
  citation={academicCitation}
  jsonLd={[scholarlyArticleJsonLd, breadcrumbJsonLd]}
  keywords={project.tags.length > 0 ? project.tags.join(', ') : undefined}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">

    <nav class="flex items-center gap-2 text-xs font-medium text-slate-500 mb-6" aria-label="Breadcrumb">
      <a href={url('/')} class="hover:text-slate-900 transition-colors">Home</a>
      <span aria-hidden="true">/</span>
      <a href={url(parentCategoryPath)} class="hover:text-slate-900 transition-colors">{parentCategoryName}</a>
      <span aria-hidden="true">/</span>
      <span class="text-slate-900 truncate max-w-[200px] sm:max-w-md" aria-current="page">{project.title}</span>
    </nav>

    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-200">
          {project.category}
        </span>
        {project.tags.map(tag => (
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700">
            {tag}
          </span>
        ))}
        <time class="text-xs text-slate-400 ml-auto" datetime={project.date}>
          {project.date}
        </time>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        {project.title}
      </h1>

      {authors.length > 0 && (
        <div class="mt-4 pt-4 border-t border-slate-200/80 flex flex-wrap items-center gap-y-1 gap-x-2 text-sm text-slate-700 font-medium">
          <span class="text-slate-400 font-normal">Authors:</span>
          {authors.map(({ name, person }, idx) => (
            <span>
              {person ? (
                <a
                  href={url(`/people/#${person.slug}`)}
                  class="text-brand-700 hover:text-brand-800 hover:underline decoration-brand-300 underline-offset-2"
                  title={`${person.name} · ${person.role} at UPNALAB`}
                >{name}</a>
              ) : (
                <span class="text-slate-900">{name}</span>
              )}
              {idx < authors.length - 1 && <span class="text-slate-300 ml-2">·</span>}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="mb-10">
      <VideoPlayer
        videoUrl={project.paperVideo || project.videoPreview}
        poster={thumbnail}
        title={project.title}
      />
    </div>

    {(hasDoiOrPaper || project.instructablesUrl) && (
      <div class="mb-10 p-5 rounded-2xl bg-brand-50/70 border border-brand-100 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="text-center sm:text-left">
          <h2 class="text-sm font-bold text-brand-900">
            {hasDoiOrPaper ? 'Peer-Reviewed Academic Publication' : 'Open Hardware Guide'}
          </h2>
          <p class="text-xs text-brand-700 mt-0.5">
            {hasDoiOrPaper ? 'Read the full paper, experimental results and appendices.' : 'Explore step-by-step schematics and instructions.'}
          </p>
          {doi && <p class="text-xs text-brand-700/80 mt-1 font-mono">DOI: <a href={`https://doi.org/${doi}`} target="_blank" rel="noopener noreferrer" class="underline decoration-brand-300 hover:text-brand-900 hover:decoration-brand-700">{doi}</a></p>}
        </div>
        <div class="flex flex-wrap items-center gap-3">
          {project.instructablesUrl && (
            <a
              href={project.instructablesUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-medium text-sm shadow-sm transition-colors whitespace-nowrap"
            >
              <span>Build on Instructables</span>
              <Icon name="external" class="w-4 h-4" />
            </a>
          )}
          {hasDoiOrPaper && (
            <a
              href={paperLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-medium text-sm shadow-sm transition-colors whitespace-nowrap"
            >
              <span>Read Full Paper</span>
              <Icon name="external" class="w-4 h-4" />
            </a>
          )}
        </div>
      </div>
    )}

    {project.abstract && (
      <section class="mb-12">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight mb-4">
          Abstract
        </h2>
        <div class="prose prose-slate max-w-none text-base leading-relaxed text-slate-700 text-justify">
          <p>{project.abstract}</p>
        </div>
      </section>
    )}

    {(project.bibtex || project.apa) && (
      <section class="mt-12 pt-10 border-t border-slate-200 space-y-6">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
          Cite this Work
        </h2>

        {project.apa && (
          <div class="rounded-xl bg-white p-5 border border-slate-200 shadow-xs">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">APA Format</h3>
            <p class="text-sm text-slate-700 font-serif leading-relaxed italic">
              {project.apa}
            </p>
          </div>
        )}

        {project.bibtex && (
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">BibTeX Entry</h3>
            <BibtexBlock bibtex={project.bibtex} />
          </div>
        )}
      </section>
    )}

    <div class="mt-14 pt-8 border-t border-slate-200 flex items-center justify-between flex-wrap gap-3">
      <a
        href={url(parentCategoryPath)}
        class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:text-brand-700"
      >
        <Icon name="arrow-left" class="w-4 h-4" />
        <span>Back to {parentCategoryName}</span>
      </a>
    </div>

  </article>
</BaseLayout>
