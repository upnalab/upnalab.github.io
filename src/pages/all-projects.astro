---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import projectsData from '../data/projects.json';

const researchProjects = projectsData.filter(p => p.category === 'Research Project');
---

<BaseLayout
  title="All Research Projects · UPNALAB"
  description="Full catalog of research publications and interactive devices developed at UPNALAB."
>
  <ProjectGrid 
    projects={researchProjects} 
    title="All Research Projects"
    subtitle="Interactive archive of peer-reviewed research, prototypes, and devices created at UPNALAB."
  />
</BaseLayout>
