---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../data/site-data.json';
import { url } from '../utils/url';

const { about } = siteData;
---

<BaseLayout
  title="About Us & Funding Grants · UPNALAB"
  description="Learn about UPNALAB's mission, core values, research expertise and institutional European and national grants."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    
    <!-- Hero / Intro -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
        {about.headline}
      </h1>
      <p class="mt-6 text-base sm:text-lg text-slate-600 leading-relaxed">
        {about.subheadline}
      </p>
    </div>

    <!-- Expertise & Values 2-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 mb-20">
      
      <!-- Expertise Card -->
      <div class="p-8 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center mb-6">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Research Expertise</h2>
        <ul class="space-y-3">
          {about.expertise.map(item => (
            <li class="flex items-start gap-3 text-sm text-slate-700">
              <svg class="w-5 h-5 text-brand-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Values Card -->
      <div class="p-8 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center mb-6">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Our Values</h2>
        <div class="space-y-4">
          {about.values.map(val => (
            <div>
              <h3 class="font-bold text-sm text-slate-900">{val.title}</h3>
              <p class="mt-1 text-sm text-slate-600 leading-relaxed">{val.description}</p>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Sponsors & Institutional Funding Grants -->
    <section class="mt-16 pt-12 border-t border-slate-200">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          Funding & Institutional Sponsors
        </h2>
        <p class="mt-2 text-sm text-slate-600">
          Our research is made possible thanks to competitive European and regional research grants.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {about.sponsors.map(sponsor => (
          <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-sm flex flex-col items-center text-center justify-between">
            <div class="h-20 flex items-center justify-center w-full mb-4">
              <img
                src={url(sponsor.logo)}
                alt={sponsor.title}
                loading="lazy"
                class="max-h-16 max-w-[180px] object-contain"
              />
            </div>
            <p class="text-xs font-medium text-slate-700 leading-snug">
              {sponsor.title}
            </p>
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
