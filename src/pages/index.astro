---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import projectsData from '../data/projects.json';
import { url } from '../utils/url';

// Filter strictly research projects for home view
const researchProjects = projectsData.filter(p => p.category === 'Research Project');
---

<BaseLayout
  title="UPNALAB · Combining computer science, physics, electronics, mechanics and chemistry to create interactive devices"
  description="UPNALAB is a cutting-edge research group at the Public University of Navarre (UPNA) combining computer science, physics, electronics, mechanics and chemistry to create interactive devices."
>
  <!-- Accessible Semantic H1 for Search Engines and Screen Readers -->
  <h1 class="sr-only">UPNALAB · Combining computer science, physics, electronics, mechanics and chemistry to create interactive devices</h1>

  <div id="projects" class="pt-2 sm:pt-4">
    <ProjectGrid 
      projects={researchProjects} 
    />
  </div>
</BaseLayout>
