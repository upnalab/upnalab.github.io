---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { getResearchProjects } from '../utils/data';

const researchProjects = await getResearchProjects();
---

<BaseLayout
  title="UPNALAB · Combining computer science, physics, electronics, mechanics and chemistry to create interactive devices"
  description="UPNALAB is a cutting-edge research group at the Public University of Navarre (UPNA) combining computer science, physics, electronics, mechanics and chemistry to create interactive devices."
>
  <h1 class="sr-only">UPNALAB · Combining computer science, physics, electronics, mechanics and chemistry to create interactive devices</h1>

  <div id="projects">
    <ProjectGrid projects={researchProjects} />
  </div>
</BaseLayout>
