---
import type { ImageMetadata } from 'astro';
import { getImage as optimizeImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../utils/url';
import { siteData } from '../utils/data';
import '../styles/global.css';

export interface AcademicCitation {
  title?: string;
  authors?: string[];
  date?: string;
  doi?: string | null;
  pdfUrl?: string;
  publicationUrl?: string;
}

interface Props {
  title?: string;
  description?: string;
  /** Social preview image. A bundled image is resized to 1200×630; omit to use the default. */
  image?: ImageMetadata;
  article?: boolean;
  citation?: AcademicCitation;
  jsonLd?: Record<string, any> | Record<string, any>[];
  keywords?: string;
}

const SITE = 'https://upnalab.com';

const {
  title = "UPNALAB · Combining computer science, physics, electronics, mechanics and chemistry to create interactive devices",
  description = "UPNALAB is a cutting-edge research group at the Public University of Navarre (UPNA) combining computer science, physics, electronics, mechanics and chemistry to create interactive devices.",
  image,
  article = false,
  citation,
  jsonLd,
  keywords,
} = Astro.props;

const basePath = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const pathname = Astro.url.pathname;
const cleanPath = basePath && pathname.startsWith(basePath)
  ? pathname.slice(basePath.length)
  : pathname;
const normalizedPath = cleanPath.startsWith('/') ? cleanPath : `/${cleanPath}`;
const canonicalURL = new URL(normalizedPath, SITE);

// Open Graph image: always 1200×630 (A8). Project thumbnails are cropped to that ratio at build time.
const OG_WIDTH = 1200;
const OG_HEIGHT = 630;
let ogImageUrl = `${SITE}/og-default.png`;
if (image) {
  const og = await optimizeImage({ src: image, width: OG_WIDTH, height: OG_HEIGHT, fit: 'cover', format: 'jpg', quality: 82 });
  ogImageUrl = og.src.startsWith('http') ? og.src : `${SITE}${og.src}`;
}

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "ResearchOrganization",
  "@id": `${SITE}/#organization`,
  "name": "UPNALAB",
  "alternateName": "UPNA Interactive Devices Research Group",
  "url": SITE,
  "logo": `${SITE}/og-default.png`,
  "description": "Research group combining computer science, physics, electronics, mechanics and chemistry to create interactive devices.",
  "parentOrganization": {
    "@type": "CollegeOrUniversity",
    "name": "Universidad Pública de Navarra",
    "alternateName": "UPNA",
    "url": "https://www.unavarra.es"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Edificio Los Tejos, Campus Arrosadia",
    "addressLocality": "Pamplona",
    "addressRegion": "Navarra",
    "postalCode": "31006",
    "addressCountry": "ES"
  },
  "sameAs": [
    "https://twitter.com/upnalab",
    "https://www.youtube.com/@UpnaLab",
    "https://github.com/upnalab",
    "https://www.instructables.com/member/UpnaLab/"
  ]
};

const goatcounter = siteData.analytics?.goatcounter?.trim();
---

<!doctype html>
<html lang="en" class="h-full bg-slate-50 text-slate-900 antialiased selection:bg-brand-500 selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={url('/favicon.png')} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={url('/favicon-192x192.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={url('/apple-touch-icon.png')} />
    <link rel="shortcut icon" href={url('/favicon.ico')} />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords || "UPNALAB, UPNA, interactive devices, acoustic levitation, volumetric displays, mid-air haptics, tangible interaction, HCI, computer science, physics, electronics, mechanics, chemistry"} />
    <meta name="theme-color" content="#0f172a" />

    <meta property="og:site_name" content="UPNALAB" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:site" content="@upnalab" />
    <meta property="twitter:creator" content="@upnalab" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />
    <meta property="twitter:image:alt" content={title} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    {jsonLd && (
      Array.isArray(jsonLd) ? (
        jsonLd.map(item => (
          <script type="application/ld+json" set:html={JSON.stringify(item)} />
        ))
      ) : (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    )}

    {citation && (
      <>
        {citation.title && <meta name="citation_title" content={citation.title} />}
        {citation.authors && citation.authors.map(author => (
          <meta name="citation_author" content={author} />
        ))}
        {citation.date && <meta name="citation_publication_date" content={citation.date} />}
        {citation.doi && <meta name="citation_doi" content={citation.doi} />}
        {citation.pdfUrl && <meta name="citation_pdf_url" content={citation.pdfUrl} />}
        {citation.publicationUrl && <meta name="citation_abstract_html_url" content={citation.publicationUrl} />}
      </>
    )}

    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    {/* Cookie-less, privacy-friendly analytics (see src/data/site-data.json → analytics). No consent banner required. */}
    {goatcounter && (
      <script is:inline data-goatcounter={`https://${goatcounter}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>
    )}
  </head>

  <body class="flex min-h-full flex-col bg-slate-50 text-slate-900">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-3 focus:py-2 focus:rounded-md focus:bg-brand-600 focus:text-white">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
