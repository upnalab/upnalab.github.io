---
import { url } from '../utils/url';

export interface Person {
  slug: string;
  name: string;
  role: string;
  category: 'Active' | 'Visitors' | 'Alumni';
  subCategory: string;
  photo: string;
  bio: string;
  links: {
    website: string;
    linkedin: string;
    scholar: string;
    orcid: string;
    upna: string;
    twitter: string;
    github: string;
    email: string;
  };
}

interface Props {
  person: Person;
}

const { person } = Astro.props;
const hasBio = Boolean(person.bio && person.bio.trim().length > 10);
---

<div 
  class="person-card group flex flex-col items-center text-center p-6 bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-lg transition-all duration-200"
  data-category={person.category.toLowerCase()}
  data-name={person.name.toLowerCase()}
>
  <!-- Photo with hover effect and modal trigger -->
  <button
    type="button"
    class="open-bio-modal-btn relative w-32 h-32 sm:w-36 sm:h-36 mb-4 rounded-full overflow-hidden bg-slate-100 ring-4 ring-slate-100 group-hover:ring-brand-100 transition-all duration-200 cursor-pointer block focus:outline-hidden focus:ring-2 focus:ring-brand-500"
    data-person-slug={person.slug}
    aria-label={`View profile and bio for ${person.name}`}
  >
    <img
      src={url(person.photo)}
      alt={person.name}
      loading="lazy"
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
    />
  </button>

  <!-- Name & Role -->
  <h3 class="font-bold text-lg text-slate-900 leading-snug">
    {person.name}
  </h3>
  <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-brand-600">
    {person.role}
  </p>

  <!-- Academic & Social Badges -->
  <div class="flex items-center justify-center flex-wrap gap-2 mt-4">
    {person.links.scholar && (
      <a 
        href={person.links.scholar} 
        target="_blank" 
        rel="noopener noreferrer" 
        title="Google Scholar Profile"
        class="p-1.5 rounded-lg bg-slate-50 hover:bg-brand-50 text-slate-500 hover:text-brand-600 transition-colors border border-slate-200/60"
      >
        <img src={url('/assets/icons/google_scholar_icon.svg')} alt="Scholar" class="w-4 h-4" />
      </a>
    )}

    {person.links.orcid && (
      <a 
        href={person.links.orcid} 
        target="_blank" 
        rel="noopener noreferrer" 
        title="ORCID Record"
        class="p-1.5 rounded-lg bg-slate-50 hover:bg-emerald-50 text-slate-500 hover:text-emerald-600 transition-colors border border-slate-200/60"
      >
        <img src={url('/assets/icons/ORCID_iD.svg')} alt="ORCID" class="w-4 h-4" />
      </a>
    )}

    {person.links.upna && person.links.upna.startsWith('http') && (
      <a 
        href={person.links.upna} 
        target="_blank" 
        rel="noopener noreferrer" 
        title="Institutional Academic Profile"
        class="p-1.5 rounded-lg bg-slate-50 hover:bg-red-50 text-slate-500 hover:text-red-600 transition-colors border border-slate-200/60"
      >
        <img src={url('/assets/icons/profile.svg')} alt="UPNA Profile" class="w-4 h-4" />
      </a>
    )}

    {person.links.linkedin && (
      <a 
        href={person.links.linkedin} 
        target="_blank" 
        rel="noopener noreferrer" 
        title="LinkedIn Profile"
        class="p-1.5 rounded-lg bg-slate-50 hover:bg-sky-50 text-slate-500 hover:text-sky-600 transition-colors border border-slate-200/60"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.64 1.64 0 0 0-1.64 1.64 1.64 1.64 0 0 0 1.64 1.64 1.64 1.64 0 0 0 1.64-1.64 1.64 1.64 0 0 0-1.64-1.64Z"/>
        </svg>
      </a>
    )}

    {person.links.github && (
      <a 
        href={person.links.github} 
        target="_blank" 
        rel="noopener noreferrer" 
        title="GitHub Profile"
        class="p-1.5 rounded-lg bg-slate-50 hover:bg-slate-200 text-slate-600 hover:text-slate-900 transition-colors border border-slate-200/60"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      </a>
    )}

    {person.links.website && (
      <a 
        href={person.links.website} 
        target="_blank" 
        rel="noopener noreferrer" 
        title="Personal Website"
        class="p-1.5 rounded-lg bg-slate-50 hover:bg-brand-50 text-slate-500 hover:text-brand-600 transition-colors border border-slate-200/60"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
        </svg>
      </a>
    )}

    {person.links.email && (
      <a 
        href={`mailto:${person.links.email}`} 
        title={`Email ${person.name}`}
        class="p-1.5 rounded-lg bg-slate-50 hover:bg-amber-50 text-slate-500 hover:text-amber-600 transition-colors border border-slate-200/60"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </a>
    )}
  </div>

  <!-- Bio modal trigger -->
  <button
    type="button"
    class="open-bio-modal-btn mt-5 inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700 hover:underline cursor-pointer"
    data-person-slug={person.slug}
  >
    <span>{hasBio ? 'Read Biography' : 'View Profile'}</span>
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </button>
</div>
