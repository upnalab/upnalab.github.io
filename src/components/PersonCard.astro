---
import { Image } from 'astro:assets';
import { getImage } from '../utils/images';
import type { Person } from '../utils/data';
import PersonLinks from './PersonLinks.astro';

interface Props {
  person: Person;
}

const { person } = Astro.props;
const photo = getImage(person.photo);
---

<div
  id={person.slug}
  class="person-card group flex flex-col items-center text-center p-6 bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-lg transition-all duration-200 scroll-mt-24"
  data-category={person.category.toLowerCase()}
  data-name={person.name.toLowerCase()}
>
  <button
    type="button"
    class="open-bio-modal-btn relative w-32 h-32 sm:w-36 sm:h-36 mb-4 rounded-full overflow-hidden bg-slate-100 ring-4 ring-slate-100 group-hover:ring-brand-100 transition-all duration-200 cursor-pointer block focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
    data-person-slug={person.slug}
    aria-label={`View profile and bio for ${person.name}`}
  >
    <Image
      src={photo}
      alt={person.name}
      width={144}
      height={144}
      densities={[1, 2]}
      loading="lazy"
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
    />
  </button>

  <h3 class="font-bold text-lg text-slate-900 leading-snug">
    <button
      type="button"
      class="open-bio-modal-btn cursor-pointer hover:text-brand-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded"
      data-person-slug={person.slug}
      aria-label={`View profile and bio for ${person.name}`}
    >
      {person.name}
    </button>
  </h3>
  <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-brand-600">
    {person.role}
  </p>

  <PersonLinks person={person} variant="icons" class="justify-center mt-4" />
</div>
