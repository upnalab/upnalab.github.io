---
import ProjectCard from './ProjectCard.astro';
import Icon from './Icon.astro';
import type { Project } from '../utils/data';

interface Props {
  projects: Project[];
  title?: string;
  subtitle?: string;
}

const { 
  projects, 
  title, 
  subtitle
} = Astro.props;

// Extract all unique tags
const allTags = Array.from(
  new Set(
    projects.flatMap(p => p.tags)
  )
).filter((t): t is Exclude<typeof t, 'Student Project' | 'Student Work'> => t !== 'Student Project' && t !== 'Student Work').sort();
---

<section class="pt-2 sm:pt-3 pb-8 sm:pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  {(title || subtitle) && (
    <div class="text-center max-w-3xl mx-auto mb-8">
      {title && (
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
          {title}
        </h1>
      )}
      {subtitle && (
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
          {subtitle}
        </p>
      )}
    </div>
  )}

  <div class="mb-8 space-y-2.5">
    <div class="relative max-w-md mx-auto">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
        <Icon name="search" class="w-4 h-4" />
      </div>
      <input
        type="search"
        id="project-search-input"
        aria-label="Search projects"
        placeholder="Search projects..."
        class="w-full pl-9 pr-8 py-1.5 sm:py-2 rounded-lg border border-slate-200 bg-white text-slate-900 placeholder-slate-400 text-xs sm:text-sm shadow-2xs focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all"
        autocomplete="off"
      />
      <button
        type="button"
        id="clear-search-btn"
        class="hidden absolute inset-y-0 right-0 pr-2.5 flex items-center text-slate-400 hover:text-slate-600 focus:outline-none"
        aria-label="Clear search"
      >
        <Icon name="close" class="w-3.5 h-3.5" />
      </button>
    </div>

    <div class="flex items-center justify-center flex-wrap gap-1.5 pt-0.5">
      <button
        type="button"
        class="filter-tag-btn active-tag px-2.5 py-1 rounded-full text-[11px] sm:text-xs font-medium transition-all duration-150 bg-slate-800 text-white shadow-2xs"
        data-tag="all"
      >
        All
      </button>

      {allTags.map(tag => (
        <button
          type="button"
          class="filter-tag-btn px-2.5 py-1 rounded-full text-[11px] sm:text-xs font-medium text-slate-600 bg-slate-100/80 hover:bg-slate-200/70 hover:text-slate-900 transition-all duration-150"
          data-tag={tag.toLowerCase()}
        >
          {tag}
        </button>
      ))}
    </div>
  </div>

  <div 
    id="projects-grid"
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8"
  >
    {projects.map(project => (
      <ProjectCard project={project} />
    ))}
  </div>

  <div id="no-projects-found" class="hidden text-center py-16">
    <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-slate-100 text-slate-400 mb-3">
      <Icon name="sad" class="w-6 h-6" />
    </div>
    <h3 class="text-base font-semibold text-slate-900">No matching projects</h3>
    <p class="text-sm text-slate-500 mt-1">Try adjusting your search keywords or removing active filters.</p>
    <button
      type="button"
      id="reset-filters-btn"
      class="mt-4 inline-flex items-center px-4 py-2 rounded-lg text-xs font-semibold text-brand-600 bg-brand-50 hover:bg-brand-100 transition-colors"
    >
      Reset all filters
    </button>
  </div>
</section>

<script>
  function normalizeStr(str: string): string {
    return str
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  function setupProjectFiltering() {
    const searchInput = document.getElementById('project-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clear-search-btn');
    const resetBtn = document.getElementById('reset-filters-btn');
    const emptyState = document.getElementById('no-projects-found');
    const tagButtons = document.querySelectorAll('.filter-tag-btn');
    const cards = document.querySelectorAll('.project-card') as NodeListOf<HTMLElement>;

    if (!cards.length) return;

    let currentTag = 'all';
    let currentQuery = '';

    function filterCards() {
      let visibleCount = 0;
      const normalizedQuery = normalizeStr(currentQuery);
      const queryWords = normalizedQuery ? normalizedQuery.split(/\s+/).filter(Boolean) : [];

      cards.forEach(card => {
        const title = normalizeStr(card.getAttribute('data-title') || '');
        const authors = normalizeStr(card.getAttribute('data-authors') || '');
        const abstract = normalizeStr(card.getAttribute('data-abstract') || '');
        const rawTags = card.getAttribute('data-tags') || '[]';
        const tags: string[] = JSON.parse(rawTags);

        const cardSearchText = `${title} ${authors} ${abstract} ${tags.join(' ')}`;
        const matchesQuery = queryWords.length === 0 || queryWords.every(word => cardSearchText.includes(word));
        const matchesTag = currentTag === 'all' || tags.includes(currentTag);

        if (matchesQuery && matchesTag) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }

      window.dispatchEvent(new CustomEvent('projects-filtered'));
    }

    function setActiveButton(activeBtn: Element) {
      tagButtons.forEach(btn => {
        btn.classList.remove('bg-slate-800', 'text-white', 'shadow-2xs', 'active-tag');
        btn.classList.add('text-slate-600', 'bg-slate-100/80');
      });
      activeBtn.classList.add('bg-slate-800', 'text-white', 'shadow-2xs', 'active-tag');
      activeBtn.classList.remove('text-slate-600', 'bg-slate-100/80');
    }

    // Search input listener
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        currentQuery = searchInput.value;
        if (clearBtn) {
          if (currentQuery.length > 0) {
            clearBtn.classList.remove('hidden');
          } else {
            clearBtn.classList.add('hidden');
          }
        }
        filterCards();
      });
    }

    // Clear search button
    if (clearBtn && searchInput) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        currentQuery = '';
        clearBtn.classList.add('hidden');
        searchInput.focus();
        filterCards();
      });
    }

    // Reset button
    if (resetBtn && searchInput) {
      resetBtn.addEventListener('click', () => {
        searchInput.value = '';
        currentQuery = '';
        if (clearBtn) clearBtn.classList.add('hidden');
        currentTag = 'all';
        const allBtn = Array.from(tagButtons).find(b => b.getAttribute('data-tag') === 'all');
        if (allBtn) setActiveButton(allBtn);
        filterCards();
      });
    }

    // Tag button listeners
    tagButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        currentTag = btn.getAttribute('data-tag') || 'all';
        setActiveButton(btn);
        filterCards();
      });
    });
  }

  setupProjectFiltering();
  document.addEventListener('astro:page-load', setupProjectFiltering);
</script>
