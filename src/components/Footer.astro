---
import { Image } from 'astro:assets';
import { url } from '../utils/url';
import { siteData } from '../utils/data';
import ObfuscatedEmail from './ObfuscatedEmail.astro';
import mapImage from '../assets/images/site/map.webp';

const currentYear = new Date().getFullYear();
const { contact } = siteData;

const navLinks = [
  { name: 'Research Projects', href: '/' },
  { name: 'Student Projects', href: '/student-projects' },
  { name: 'Do-It-Yourself Guides', href: '/do-it-yourself' },
  { name: 'People & Team', href: '/people' },
  { name: 'About Us & Grants', href: '/about' },
];

const communityLinks = [
  { name: 'GitHub', href: 'https://github.com/upnalab' },
  { name: 'YouTube', href: 'https://www.youtube.com/@UpnaLab' },
  { name: 'Instructables', href: 'https://www.instructables.com/member/UpnaLab/' },
  { name: 'Twitter / X', href: 'https://twitter.com/upnalab' },
  { name: 'Universidad Pública de Navarra', href: 'https://www.unavarra.es' },
];
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-3">Navigation</h3>
        <ul class="space-y-2 text-sm">
          {navLinks.map(l => (
            <li><a href={url(l.href)} class="hover:text-white transition-colors">{l.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-3">Community</h3>
        <ul class="space-y-2 text-sm">
          {communityLinks.map(l => (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1.5">
                <span>{l.name}</span>
                <span class="text-xs text-slate-500" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div id="contact">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-3">Location & Contact</h3>
        <p class="text-xs text-slate-400 mb-3 leading-relaxed">
          {contact.addressLine1}<br />
          {contact.addressLine2}
        </p>
        <a
          href={contact.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open UPNALAB location in Google Maps"
          class="group block relative rounded-xl overflow-hidden border-2 border-brand-500/60 hover:border-brand-400 transition-all duration-200 shadow-md aspect-[16/10] w-full bg-slate-950"
        >
          <Image
            src={mapImage}
            alt="Map showing the UPNALAB building on the Arrosadia campus"
            widths={[400, 800]}
            sizes="(min-width: 768px) 400px, 100vw"
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          />
          <div class="absolute inset-0 bg-slate-950/10 group-hover:bg-transparent transition-colors"></div>
          <div class="absolute bottom-2 right-2 px-2.5 py-1 rounded-md bg-slate-900/90 backdrop-blur-xs text-[11px] font-medium text-white flex items-center gap-1.5 shadow-sm group-hover:bg-brand-600 transition-colors">
            <span>Google Maps</span>
            <span class="text-xs" aria-hidden="true">↗</span>
          </div>
        </a>

        <div class="mt-3">
          <ObfuscatedEmail
            email={contact.email}
            showText
            title="Send us an email"
            aria-label="Send an email to UPNALAB"
            class="w-full flex items-center justify-between gap-2 px-3 py-2 rounded-xl bg-slate-800/80 hover:bg-slate-800 border border-slate-700/80 hover:border-brand-500/60 transition-all text-[11px] text-slate-300 hover:text-white group shadow-xs"
          />
        </div>
      </div>

    </div>

    <div class="mt-12 pt-8 border-t border-slate-800/80 text-xs text-slate-500 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <p>© {currentYear} UPNALAB · Universidad Pública de Navarra. All rights reserved.</p>
      <p class="flex items-center gap-3">
        <a href={url('/privacy')} class="hover:text-white transition-colors">Privacy & Legal Notice</a>
        <span aria-hidden="true">·</span>
        <span>No cookies on this site</span>
      </p>
    </div>
  </div>
</footer>
