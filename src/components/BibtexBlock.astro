---
import Icon from './Icon.astro';

interface Props {
  bibtex: string;
  /** Compact variant for dense lists */
  compact?: boolean;
}

const { bibtex, compact = false } = Astro.props;
---

<div class="relative group rounded-xl bg-slate-900 text-slate-100 overflow-hidden border border-slate-800 shadow-md">
  <div class="flex items-center justify-between px-4 py-2.5 bg-slate-800/80 border-b border-slate-700/60">
    <div class="flex items-center gap-2">
      {!compact && (
        <>
          <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
        </>
      )}
      <span class={`${compact ? '' : 'ml-2'} text-xs font-mono font-medium text-slate-400`}>BibTeX</span>
    </div>

    <button
      type="button"
      class="copy-bibtex-btn inline-flex items-center gap-1.5 px-3 py-1 text-xs font-medium rounded-md bg-slate-700 hover:bg-brand-600 text-slate-200 hover:text-white transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand-500"
      data-bibtex={bibtex}
      aria-label="Copy BibTeX citation to clipboard"
    >
      <span class="copy-icon"><Icon name="copy" class="w-3.5 h-3.5" /></span>
      <span class="check-icon hidden text-emerald-400"><Icon name="check" class="w-3.5 h-3.5" /></span>
      <span class="btn-text">Copy</span>
    </button>
  </div>

  <pre class={`p-4 overflow-x-auto font-mono leading-relaxed text-slate-200 selection:bg-brand-600 selection:text-white ${compact ? 'text-xs' : 'text-xs sm:text-sm'}`}><code>{bibtex}</code></pre>
</div>

<script>
  async function copyTextToClipboard(text: string): Promise<boolean> {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // Fallback to execCommand
      }
    }
    try {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.focus();
      textarea.select();
      // eslint-disable-next-line @typescript-eslint/no-deprecated
      const success = (document as any).execCommand('copy');
      document.body.removeChild(textarea);
      return success;
    } catch {
      return false;
    }
  }

  function initBibtexCopyButtons() {
    document.querySelectorAll('.copy-bibtex-btn').forEach(btn => {
      if ((btn as HTMLElement).dataset.ready) return;
      (btn as HTMLElement).dataset.ready = 'true';
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-bibtex') || '';
        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');
        const btnText = btn.querySelector('.btn-text');

        const success = await copyTextToClipboard(text);
        if (success && copyIcon && checkIcon && btnText) {
          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');
          btnText.textContent = 'Copied!';
          btn.classList.add('bg-emerald-700', 'text-white');

          setTimeout(() => {
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
            btnText.textContent = 'Copy';
            btn.classList.remove('bg-emerald-700', 'text-white');
          }, 2000);
        }
      });
    });
  }

  initBibtexCopyButtons();
  document.addEventListener('astro:page-load', initBibtexCopyButtons);
</script>
