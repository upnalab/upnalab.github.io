---
import { Image } from 'astro:assets';
import { url } from '../utils/url';
import Icon from './Icon.astro';
import logo from '../assets/images/site/upnalab_header_logo.png';

const pathname = Astro.url.pathname;

const navItems = [
  { name: 'Research Projects', href: '/' },
  { name: 'Student Projects', href: '/student-projects' },
  { name: 'Do-It-Yourself', href: '/do-it-yourself' },
  { name: 'People', href: '/people' },
  { name: 'About Us', href: '/about' },
];

const socialLinks = [
  { name: 'Twitter / X', href: 'https://twitter.com/upnalab', icon: 'x', hover: 'hover:text-slate-900' },
  { name: 'YouTube', href: 'https://www.youtube.com/@UpnaLab', icon: 'youtube', hover: 'hover:text-red-600' },
  { name: 'GitHub', href: 'https://github.com/upnalab', icon: 'github', hover: 'hover:text-slate-900' },
] as const;

function isActive(href: string) {
  const current = pathname.replace(/\/$/, '') || '/';
  const target = url(href).replace(/\/$/, '') || '/';
  if (target === '/' || target === url('/').replace(/\/$/, '')) {
    return current === target;
  }
  return current.startsWith(target);
}
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href={url('/')} class="flex items-center group focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-lg p-1">
        <Image
          src={logo}
          alt="UPNALAB"
          height={36}
          densities={[1, 2]}
          loading="eager"
          class="h-8 sm:h-9 w-auto transition-transform duration-200 group-hover:scale-105"
        />
      </a>

      <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Main navigation">
        {navItems.map(item => {
          const active = isActive(item.href);
          return (
            <a
              href={url(item.href)}
              aria-current={active ? 'page' : undefined}
              class={`px-3 py-2 text-sm font-medium rounded-md transition-colors duration-150 ${
                active
                  ? 'text-brand-600 bg-brand-50 font-semibold shadow-sm'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/80'
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <div class="hidden sm:flex items-center gap-3 pl-2 border-l border-slate-200">
        {socialLinks.map(s => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`UPNALAB on ${s.name}`}
            class={`text-slate-400 ${s.hover} transition-colors p-1.5 rounded-md hover:bg-slate-100`}
          >
            <Icon name={s.icon} class="w-4 h-4" />
          </a>
        ))}
      </div>

      <div class="flex items-center md:hidden">
        <button
          type="button"
          id="mobile-menu-button"
          class="p-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
        >
          <span id="menu-icon"><Icon name="menu" class="h-6 w-6" /></span>
          <span id="close-icon" class="hidden"><Icon name="close" class="h-6 w-6" /></span>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 bg-white px-4 pt-2 pb-4 space-y-1 shadow-lg">
    {navItems.map(item => {
      const active = isActive(item.href);
      return (
        <a
          href={url(item.href)}
          aria-current={active ? 'page' : undefined}
          class={`block px-3 py-2 rounded-md text-base font-medium transition-colors ${
            active
              ? 'text-brand-600 bg-brand-50 font-semibold'
              : 'text-slate-700 hover:text-slate-900 hover:bg-slate-100'
          }`}
        >
          {item.name}
        </a>
      );
    })}
    <div class="pt-3 border-t border-slate-100 flex items-center flex-wrap gap-4 px-3">
      {socialLinks.map(s => (
        <a href={s.href} target="_blank" rel="noopener noreferrer" class={`text-slate-500 ${s.hover} text-sm flex items-center gap-1.5`}>
          {s.name}
        </a>
      ))}
      <a href="https://www.instructables.com/member/UpnaLab/" target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-amber-600 text-sm flex items-center gap-1.5">
        Instructables
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (btn && menu && menuIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden', isOpen);
      menuIcon.classList.toggle('hidden', !isOpen);
      closeIcon.classList.toggle('hidden', isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  }
</script>
