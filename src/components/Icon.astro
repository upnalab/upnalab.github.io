const { name, class: className = 'w-4 h-4', 'aria-hidden': ariaHidden = true } = Astro.props;
const icon = icons[name];
---

{icon.fill ? (
  <svg class={className} fill="currentColor" viewBox="0 0 24 24" aria-hidden={ariaHidden}>
    <path fill-rule="evenodd" clip-rule="evenodd" d={icon.path} />
  </svg>
) : (
  <svg class={className} fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden={ariaHidden}>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icon.path} />
  </svg>
)}
