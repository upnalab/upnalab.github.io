---
import { Image } from 'astro:assets';
import { url } from '../utils/url';
import { getImage } from '../utils/images';
import { projectsOfPerson, type Person, type Project } from '../utils/data';
import Icon from './Icon.astro';
import PersonLinks from './PersonLinks.astro';

interface Props {
  people: Person[];
  projects: Project[];
}

const { people, projects } = Astro.props;
---

{people.map(person => {
  const personProjects = projectsOfPerson(person, projects);
  const hasBio = person.bio && person.bio.trim().length > 10;
  return (
  <dialog
    id={`bio-modal-${person.slug}`}
    class="bio-dialog fixed inset-0 m-auto w-[92%] max-w-2xl max-h-[88vh] p-0 rounded-2xl bg-white shadow-2xl backdrop:bg-slate-900/60 backdrop:backdrop-blur-xs border border-slate-200 overflow-hidden"
    aria-labelledby={`bio-title-${person.slug}`}
  >
    <div class="relative bg-slate-50/90 px-6 py-6 border-b border-slate-200">
      <div class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-5">
        <div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-2xl overflow-hidden bg-slate-100 ring-4 ring-white shadow-md shrink-0 border border-slate-200/80">
          <Image
            src={getImage(person.photo)}
            alt={person.name}
            width={128}
            height={128}
            densities={[1, 2]}
            loading="lazy"
            class="w-full h-full object-cover object-center"
          />
        </div>

        <div class="flex-1 min-w-0 pr-0 sm:pr-8">
          <h3 id={`bio-title-${person.slug}`} class="text-xl sm:text-2xl font-bold text-slate-900 leading-tight">
            {person.name}
          </h3>
          <p class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-brand-600 mt-1">
            {person.role}
          </p>

          <PersonLinks person={person} variant="pills" class="justify-center sm:justify-start mt-4" />
        </div>
      </div>

      <button
        type="button"
        class="close-bio-btn absolute top-4 right-4 p-2 rounded-xl text-slate-400 hover:text-slate-700 hover:bg-slate-200/70 transition-colors"
        data-close-target={`bio-modal-${person.slug}`}
        aria-label="Close dialog"
      >
        <Icon name="close" class="w-5 h-5" />
      </button>
    </div>

    <div class="p-6 sm:p-8 overflow-y-auto max-h-[calc(88vh-220px)] text-sm leading-relaxed">
      {hasBio ? (
        <div class="prose prose-slate max-w-none" set:html={person.bio} />
      ) : (
        <p class="text-slate-500 italic">No detailed biography available.</p>
      )}

      {personProjects.length > 0 && (
        <section class="mt-6 pt-5 border-t border-slate-200">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
            Projects at UPNALAB ({personProjects.length})
          </h4>
          <ul class="space-y-1.5">
            {personProjects.map(pr => (
              <li class="flex items-baseline gap-2">
                <span class="text-xs font-mono text-slate-400 shrink-0">{pr.year}</span>
                <a href={url(`/project/${pr.slug}/`)} class="text-brand-700 hover:text-brand-800 hover:underline font-medium">
                  {pr.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <div class="px-6 py-3.5 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
      <span class="text-xs text-slate-500 font-medium">UPNALAB · Universidad Pública de Navarra</span>
      <button
        type="button"
        class="close-bio-btn px-4 py-1.5 text-xs font-semibold rounded-lg bg-slate-200 text-slate-700 hover:bg-slate-300 transition-colors cursor-pointer"
        data-close-target={`bio-modal-${person.slug}`}
      >
        Close
      </button>
    </div>
  </dialog>
  );
})}

<script>
  function openPersonDialog(slug: string) {
    const dialog = document.getElementById(`bio-modal-${slug}`) as HTMLDialogElement | null;
    if (dialog && !dialog.open) dialog.showModal();
  }

  function setupBioModals() {
    document.querySelectorAll('.open-bio-modal-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-person-slug');
        if (slug) openPersonDialog(slug);
      });
    });

    document.querySelectorAll('.close-bio-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-close-target');
        const dialog = targetId ? (document.getElementById(targetId) as HTMLDialogElement | null) : null;
        dialog?.close();
      });
    });

    // Close on backdrop click
    document.querySelectorAll<HTMLDialogElement>('.bio-dialog').forEach(dialog => {
      dialog.addEventListener('click', (e) => {
        const rect = dialog.getBoundingClientRect();
        const inside = rect.top <= e.clientY && e.clientY <= rect.bottom && rect.left <= e.clientX && e.clientX <= rect.right;
        if (!inside) dialog.close();
      });
    });

    // Deep link: /people/#person-slug opens that person's profile (used by project pages)
    const openFromHash = () => {
      const slug = decodeURIComponent(window.location.hash.replace(/^#/, ''));
      if (slug && document.getElementById(`bio-modal-${slug}`)) openPersonDialog(slug);
    };
    openFromHash();
    window.addEventListener('hashchange', openFromHash);
  }

  setupBioModals();
  document.addEventListener('astro:page-load', setupBioModals);
</script>
